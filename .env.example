# Runtime mode. Production refuses the development JWT secret.
APP_ENV=development
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
DATABASE_PATH=/data/bloomsense.db
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
MAX_UPLOAD_BYTES=10485760

# Use the same Web client ID in the frontend and API.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Server-side only. Never expose this value through VITE_* variables.
PLANTNET_API_KEY=

# Optional LibreTranslate-compatible endpoint, for example https://translate.example.com
TRANSLATE_API_URL=
TRANSLATE_API_KEY=

# true = self-contained static demonstration; false = real API/authentication.
VITE_DEMO_MODE=true
VITE_API_URL=/api/v1
